{
    "name": "dinamiko/content-pdf",
    "description": "WordPress PDF Generator",
    "type": "wordpress-plugin",
    "require": {
        "inpsyde/modularity": "^1.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dinamiko\\ContentPdf\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dinamiko\\ContentPdf\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint:php": "phpcs",
        "lint:php:fix": "phpcbf"
    }
}
