{
  "name": "content-pdf",
  "version": "0.0.1",
  "description": "WordPress PDF Generator",
  "author": "Dinamiko",
  "license": "MIT",
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "wp-env": "wp-env",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/content-pdf vendor/bin/phpunit tests/unit",
    "test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
    "test:e2e:debug": "wp-scripts test-playwright --config tests/e2e/playwright.config.js --ui",
    "demo:seed": "wp-env run cli --env-cwd=wp-content/plugins/content-pdf wp eval-file bin/demo-content/demo.php seed",
    "demo:seed:classic": "wp-env run cli --env-cwd=wp-content/plugins/content-pdf wp eval-file bin/demo-content/demo.php seed classic",
    "demo:clean": "wp-env run cli --env-cwd=wp-content/plugins/content-pdf wp eval-file bin/demo-content/demo.php clean",
    "playground": "wp-playground-cli server --mount=.:/wordpress/wp-content/plugins/content-pdf --blueprint=bin/playground/blueprint.json",
    "lint:php": "composer lint:php",
    "lint:php:fix": "composer lint:php:fix",
    "copy-vendor": "node bin/copy-vendor.mjs",
    "dist": "npm run build && node bin/dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@wordpress/e2e-test-utils-playwright": "^2.1.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^35.0.0",
    "@wp-playground/cli": "^3.1.64",
    "dompdf.js": "2.0.6"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/dataviews": "^22.0.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/notices": "^6.1.0"
  }
}
