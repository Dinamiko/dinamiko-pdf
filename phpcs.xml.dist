<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Dinamiko PDF" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>Coding standards for the Dinamiko PDF plugin.</description>

	<file>dinamiko-pdf.php</file>
	<file>modules</file>
	<file>tests/unit</file>
	<file>bin</file>

	<!-- Generated by wp-scripts (index.asset.php). -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Classes follow PSR-4 (modules/Button/Module.php), not class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is used throughout the codebase. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Allow inline type hints such as /** @var Package $package */. -->
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<!-- Test classes and methods are self-describing; docblocks are not required. -->
	<rule ref="Squiz.Commenting.FileComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dinamiko-pdf"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dinamiko_pdf"/>
				<element value="Dinamiko\DinamikoPdf"/>
			</property>
		</properties>
	</rule>
</ruleset>
